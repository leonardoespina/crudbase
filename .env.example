# ── CONFIGURACIÓN DEL ENTORNO (CRUDBASE) ──────────────────────────

# Nombre del Sistema
APP_NAME="CRUDBASE"
PORT=3000
NODE_ENV="development"

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crudbase_db?schema=public"

# Secreto JWT (Mínimo 32 caracteres)
JWT_SECRET="cambia_este_secreto_en_produccion_con_uno_de_mas_de_32_chars"

# Zona Horaria Comercial de la Empresa
APP_TIMEZONE="America/Caracas"

# Cookies: false para red local HTTP puro (http://10.x.x.x); true si usas HTTPS/Reverse Proxy
COOKIE_SECURE="false"
