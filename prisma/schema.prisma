// Prisma Schema - CRUDBASE
// Sistema Empresarial Base con Soporte Multisede, RBAC Dinámico y Auditoría

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── SEDES (MULTISEDE NATIVO) ────────────────────────────────────────────────
model Branch {
  id          Int       @id @default(autoincrement())
  code        String    @unique // Ej: "CENTRAL", "NORTE"
  name        String
  description String?
  active      Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users       User[]

  @@map("branches")
}

// ── ROLES Y MATRIZ DINÁMICA DE PERMISOS ──────────────────────────────────────
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // Ej: "ADMIN", "OPERATOR"
  description String?
  isSystem    Boolean          @default(false) @map("is_system") // Protege al rol ADMIN de ser borrado
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Module {
  id          Int              @id @default(autoincrement())
  code        String           @unique // Ej: "USERS", "ROLES", "BRANCHES", "AUDIT", "SETTINGS"
  name        String           // Ej: "Gestión de Usuarios"
  category    String           @default("GENERAL") // Ej: "SEGURIDAD", "CATALOGOS", "OPERACIONES"
  permissions RolePermission[]

  @@map("modules")
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId  Int      @map("module_id")
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  canCreate Boolean  @default(false) @map("can_create")
  canRead   Boolean  @default(false) @map("can_read")
  canUpdate Boolean  @default(false) @map("can_update")
  canDelete Boolean  @default(false) @map("can_delete")

  @@unique([roleId, moduleId])
  @@map("role_permissions")
}

// ── USUARIOS ───────────────────────────────────────────────────────────────
model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  name            String
  email           String?
  passwordHash    String    @map("password_hash")
  active          Boolean   @default(true)
  deletedAt       DateTime? @map("deleted_at")

  roleId          Int       @map("role_id")
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  branchId        Int?      @map("branch_id") // Sede asignada (null = acceso global si es Admin)
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  activeSessionId String?   @map("active_session_id")
  lastActiveAt    DateTime? @map("last_active_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  auditLogs       AuditLog[]

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// ── AUDITORÍA INALTERABLE ──────────────────────────────────────────────────
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  entity    String   // "User", "Role", "Branch", etc.
  entityId  Int?     @map("entity_id")
  details   String?  @db.Text // JSON con antes/después o payload
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── CONFIGURACIÓN DEL SISTEMA ──────────────────────────────────────────────
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ── CONTROL DE IDEMPOTENCIA (TRANSACCIONES SEGURAS) ─────────────────────────
model IdempotencyKey {
  key        String   @id
  path       String
  userId     Int      @map("user_id")
  statusCode Int      @map("status_code")
  response   String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
